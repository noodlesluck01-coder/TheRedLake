-- ================================================================
-- STREAK RESET (kills streak, auto-press the in-game reset button)
-- ================================================================
local RESET_STREAK = 350
local lastResetScan = 0

-- streak = our local kill counter (monsters that died within 3s of our
-- last shot); LB_Kills only syncs at match end so it is not usable live
local function getStreak()
    return stats.kills
end

local function markReset()
    stats.kills = 0
    stats.resets += 1
    print("[farm v2] streak reset done (resets #" .. stats.resets .. ")")
end

local function streakTick()
    local streak = getStreak()
    if streak < RESET_STREAK then return end
    if tick() - lastResetScan < 3 then return end
    lastResetScan = tick()
    local pg = plr:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, name in ipairs({ "Stats", "HUD", "LakeTeamHUD", "LakeXpPop", "KillStreaks" }) do
        local gui = pg:FindFirstChild(name)
        if gui then
            local hit = pressByText(gui, { "reset" })
            if hit then
                markReset()
                return
            end
        end
    end
    if streak >= RESET_STREAK + 40 then
        print("[farm v2] streak " .. streak .. " - no reset button found yet")
    end
end

-- ================================================================
-- CARD AUTO-PICK (CardPick / ResearchPick - priority: infinite ammo)
-- ================================================================
local CARD_PRIORITY = {
    "infinite", "unlimited",
    "ammo", "mag", "magazine",
    "gun", "weapon", "fire rate", "damage", "reload",
}
local lastPickTry = 0

local function cardText(b)
    local combined = ""
    pcall(function()
        combined = string.lower(tostring(b.Text or ""))
        for _, d in ipairs(b:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                combined = combined .. " " .. string.lower(tostring(d.Text))
            end
        end
    end)
    return combined
end

local function pickTick()
    if tick() - lastPickTry < 1 then return end
    lastPickTry = tick()
    local pg = plr:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, name in ipairs({ "CardPick", "ResearchPick" }) do
        local gui = pg:FindFirstChild(name)
        if gui and gui.Enabled then
            local cards = {}
            for _, d in ipairs(gui:GetDescendants()) do
                if d:IsA("GuiButton") and d.Visible
                    and d.Name ~= "Dim" and d.Name ~= "MouseFree" and d.Name ~= "Hide"
                    and d.AbsoluteSize.X < 800 and d.AbsoluteSize.Y < 800 then
                    table.insert(cards, d)
                end
            end
            local real = {}
            for _, b in ipairs(cards) do
                local named = string.match(b.Name, "^Card%d+$") ~= nil
                    or string.match(b.Name, "^Option%d+$") ~= nil
                if named or cardText(b):gsub("%s+", "") ~= "" then
                    table.insert(real, b)
                end
            end
            if #real > 0 then
                local pick, pickScore
                for _, b in ipairs(real) do
                    local txt = cardText(b)
                    for i, kw in ipairs(CARD_PRIORITY) do
                        if txt:find(kw, 1, true) then
                            local score = #CARD_PRIORITY - i + 1
                            if not pickScore or score > pickScore then
                                pick, pickScore = b, score
                            end
                            break
                        end
                    end
                end
                if not pick then pick = real[1] end
                local shown = ""
                pcall(function() shown = tostring(pick.Text) end)
                pressButton(pick)
                stats.picks += 1
                print("[farm v2] picked card in " .. name .. " ('" .. shown .. "')")
            end
        end
    end
end

