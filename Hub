local function alive()
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

-- NOT-deployed detection got harder: the update made MenuStage.Enabled
-- false ON the deploy screen, so "menu open" now means: MenuStage enabled
-- OR a real deploy/play bar is on screen. Visibility is checked through
-- the whole ancestor chain (plain .Visible alone lies post-update).
local function chainVisible(b)
    local node = b
    while node and node ~= plr do
        if node:IsA("GuiObject") then
            if not node.Visible then return false end
        elseif node:IsA("ScreenGui") then
            if not node.Enabled then return false end
        end
        node = node.Parent
    end
    return true
end

-- deploy/play bar detector v2 — geometry-driven: scans EVERY enabled
-- ScreenGui (MenuServers "QUICK PLAY" banned by name), finds chain-visible
-- buttons whose own text, NAME, or descendant labels spell deploy / play /
-- redeploy as whole words. Post-update buttons are textless with the word
-- in a child TextLabel (the big red DEPLOY bar), so .Text alone is blind.
local function findDeployButton(pg)
    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "MenuServers" then
            for _, d in ipairs(gui:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("GuiButton")) and chainVisible(d) then
                    -- ImageButton has NO Text property: raw .Text access
                    -- crashes the whole scan (that bug made deploy dead).
                    -- textless red DEPLOY bar = HUD.Root.Safehouse.Deploy.
                    local txt = " "
                    if d:IsA("TextButton") then
                        txt = txt .. string.lower(tostring(d.Text)) .. " "
                    end
                    txt = txt .. string.lower(d.Name) .. " "
                    pcall(function()
                        for _, c in ipairs(d:GetDescendants()) do
                            if c:IsA("TextLabel") then
                                txt = txt .. " " .. string.lower(tostring(c.Text)) .. " "
                            end
                        end
                        -- sibling-label style: the option frame may hold the
                        -- word label NEXT to the button (voting-card layout)
                        local par = d.Parent
                        if par then
                            txt = txt .. " " .. string.lower(par.Name) .. " "
                            for _, c in ipairs(par:GetChildren()) do
                                if c:IsA("TextLabel") then
                                    txt = txt .. " " .. string.lower(tostring(c.Text)) .. " "
                                end
                            end
                        end
                    end)
                    for w in string.gmatch(txt, "%a+") do
                        if w == "deploy" or w == "play" or w == "redeploy" then
                            if not txt:find("quick", 1, true)
                                and not txt:find("squad", 1, true) then
                                return d
                            end
                            break
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- short cache so the 1s camp loop and the 3s deploy loop share one scan
local deployScan = { t = 0, btn = nil }
local function getCachedDeploy(pg)
    if tick() - deployScan.t >= 0.5 then
        deployScan.btn = findDeployButton(pg)
        deployScan.t = tick()
    end
    return deployScan.btn
end

-- "not deployed" = the character is (still) parked around the safehouse.
-- The map arena is ~25,000 studs away the moment DeployRequest fires, so
-- distance from the safezone is the honest deployed/not-deployed signal
-- (the bottom DEPLOY bar stays visible either way - MenuStage and the bar
-- are both false signals post-update; that caused the fake-teleport camping).
local function notDeployedNow()
    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return true end
    local sz = workspace:FindFirstChild("NewSafehouse")
    if not sz then return false end
    local ok, pos = pcall(function() return sz:GetPivot().Position end)
    if not ok or not pos then return false end
    return (hrp.Position - pos).Magnitude < 600
end

local function menuOpen()
    if notDeployedNow() then return true end
    local pg = plr:FindFirstChild("PlayerGui")
    if not pg then return true end
    local ms = pg:FindFirstChild("MenuStage")
    return (ms and ms.Enabled) and true or false
end

-- click a visible GuiButton with VirtualInputManager (screen coords),
-- getconnections as a fallback bonus. The farm panel is blind during the
-- click so a game button overlapping it can never toggle our own UI.
local function pressButton(b)
    if not (b and b.Parent) then return false end
    local clicked = false
    local panel = uiHolder.handle
    pcall(function()
        if panel and panel.Parent then panel.Enabled = false end
        local pos, size = b.AbsolutePosition, b.AbsoluteSize
        if size.Magnitude > 0 and b.Visible then
            game:GetService("VirtualInputManager"):SendMouseButtonEvent(
                pos.X + size.X / 2, pos.Y + size.Y / 2, 0, true, game, 1)
            game:GetService("VirtualInputManager"):SendMouseButtonEvent(
                pos.X + size.X / 2, pos.Y + size.Y / 2, 0, false, game, 1)
            clicked = true
        end
    end)
    if not clicked then
        pcall(function()
            if getconnections then
                for _, c in ipairs(getconnections(b.Activated)) do
                    c:Fire()
                    clicked = true
                end
            end
        end)
    end
    pcall(function()
        if panel and panel.Parent then panel.Enabled = true end
    end)
    return clicked
end

-- find + press a visible button whose text contains a keyword
local function pressByText(root, words)
    if not (root and root.Parent) then return false end
    for _, d in ipairs(root:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("GuiButton")) and d.Visible then
            local txt = ""
            pcall(function() txt = string.lower(d.Text or "") end)
            for _, w in ipairs(words) do
                if string.find(txt, string.lower(w), 1, true) then
                    return pressButton(d), d
                end
            end
        end
    end
    return false
end

-- ================================================================
-- ENEMY TARGETING (NPCs folder + friendly-fire guard)
-- refreshes fast: 0.5s TTL, nested folders handled, instant retry
-- so freshly spawned enemies are never ignored
-- ================================================================
local enemyCache = {}
local cacheTimestamp = 0

-- local kill counter: monster Humanoid.Died within 3s of our last shot
-- (the LB_Kills attribute only syncs at match end)
local killWatch = {}
local lastShotTarget = nil
local lastShotTime = 0

-- friendly/team-owned guard, same hardened rules as the hub:
-- 1) real Player Character  2) spawned card/shapeshifter monsters keep an
-- ownership link (UserId / player-name / owner attribute / ObjectValue ->
-- Player)  3) friendly collections: NPC-folder Friends/Survivors and
-- "Friend"-tagged models (ally NPCs like GOC soldiers, teammate monsters)
local function isPlayerOwned(model)
    if not model then return false end
    local ok, own = pcall(function()
        return Players:GetPlayerFromCharacter(model)
    end)
    if ok and own then return true end

    local linked = false
    pcall(function()
        for k, v in pairs(model:GetAttributes()) do
            local lk = string.lower(k)
            if type(v) == "number" and lk:find("userid") then
                local p = Players:GetPlayerByUserId(tonumber(v) or -1)
                if p then linked = true end
            elseif type(v) == "string" and v ~= ""
                and (lk:find("owner") or lk:find("playername") or lk:find("username")) then
                if Players:FindFirstChild(v) then linked = true end
            end
        end
        for _, d in ipairs(model:GetChildren()) do
            if d:IsA("ObjectValue") then
                local v = d.Value
                if typeof(v) == "Instance" and v:IsA("Player") then linked = true end
            end
        end
    end)
    if linked then return true end

    local par = model.Parent
    if par and (par.Name == "Friends" or par.Name == "Survivors") then return true end
    pcall(function()
        local cs = game:GetService("CollectionService")
        for _, t in ipairs(cs:GetTags(model)) do
            if string.lower(t) == "friend" then linked = true end
        end
    end)
    return linked
end

local function refreshEnemyCache()
    local result = {}
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs then
        local function consider(m)
            if m:IsA("Model") then
                if not killWatch[m] then
                    local h = m:FindFirstChild("Humanoid")
                    if h then
                        killWatch[m] = h.Died:Connect(function()
                            local conn = killWatch[m]
                            killWatch[m] = nil
                            if conn then conn:Disconnect() end
                            if lastShotTarget == m and (tick() - lastShotTime) < 3 then
                                stats.kills += 1
                            end
                        end)
                    end
                end
                if m:FindFirstChild("Humanoid")
                    and m.Humanoid.Health > 0
                    and not isPlayerOwned(m) then
                    table.insert(result, m)
                end
            end
        end
        for _, folder in ipairs(npcs:GetChildren()) do
            -- ONLY real enemy folders: Tango + Monsters. Allies (GOC
            -- soldiers, teammate monsters) live in "Friends", corpses in
            -- "Deceased" - never shoot those.
            if folder:IsA("Folder") and (folder.Name == "Tango" or folder.Name == "Monsters") then
                for _, m in ipairs(folder:GetChildren()) do
                    if m:IsA("Model") then
                        consider(m)
                    elseif m:IsA("Folder") then
                        -- some rounds nest squads one level deeper
                        for _, mm in ipairs(m:GetChildren()) do
                            consider(mm)
                        end
                    end
                end
            end
        end
    end
    enemyCache = result
    cacheTimestamp = tick()
end

local function scanCache()
    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bestD = nil, math.huge
    for _, m in ipairs(enemyCache) do
        local part = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChild("Humanoid")
        if part and hum and hum.Health > 0 and not isPlayerOwned(m) then
            local d = (part.Position - hrp.Position).Magnitude
            if d < bestD then
                best, bestD = m, d
            end
        end
    end
    return best
end

local function getclosestenemy()
    if tick() - cacheTimestamp > 0.5 then
        refreshEnemyCache()
    end
    local best = scanCache()
    if not best then
        -- nothing picked: force a fresh scan (new spawns / died units)
        refreshEnemyCache()
        best = scanCache()
    end
    return best
end

-- ================================================================
-- GUN TOOL (gun-only: melee never picked, never fired)
-- ================================================================
local MELEE_HINTS = { "axe", "machete", "bat", "blade", "sword", "knife", "shovel", "wrench", "crowbar", "baton" }

local function isMeleeName(name)
    local lname = string.lower(name or "")
    for _, hint in ipairs(MELEE_HINTS) do
        if lname:find(hint, 1, true) then return true end
    end
    return false
end

-- preferred gun names for auto-equip (highest priority first)
local GUN_PREF = { "mp5", "rifle", "pistol", "shotgun", "smg", "minigun", "gun" }

local function getGun()
    local char = plr.Character
    if not char then return nil, nil end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local main = tool:FindFirstChild("Main")
            if not (main and main:IsA("RemoteEvent")) then
                -- some weapons only re-materialize the remote while equipped
                for _, d in ipairs(tool:GetChildren()) do
                    if d:IsA("RemoteEvent") or d:IsA("UnreliableRemoteEvent") then
                        main = d
                        break
                    end
                end
            end
            if main and main:IsA("RemoteEvent") and not isMeleeName(tool.Name) then
                return tool, main
            end
        end
    end
    return nil, nil
end

-- auto-equip a gun from the Backpack (weapons sit there unequipped)
local lastEquipTry = 0
local function autoEquipGun()
    if tick() - lastEquipTry < 1 then return false end
    lastEquipTry = tick()
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local bp = plr:FindFirstChildOfClass("Backpack")
    if not (hum and bp) then return false end
    local best, bestScore
    for _, t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") and not isMeleeName(t.Name) then
            local score = 1
            local lname = string.lower(t.Name)
            for _, p in ipairs(GUN_PREF) do
                if lname:find(p, 1, true) then
                    score = 2
                    break
                end
            end
            if not best or score > bestScore then
                best, bestScore = t, score
            end
        end
    end
    if best then
        pcall(function() hum:EquipTool(best) end)
        print("[farm v2] auto-equipped gun: " .. best.Name)
        return true
    end
    return false
end

local function getAmmo()
    local gui = plr:FindFirstChild("PlayerGui")
    if not gui then return 999 end
    local crosshair = gui:FindFirstChild("Crosshair")
    if not crosshair then return 999 end
    local counter = crosshair:FindFirstChild("Counter")
    if not counter then return 999 end
    local stored = counter:FindFirstChild("StoredAmmo")
    if not stored then return 999 end
    return tonumber(stored.Text) or 999
end

