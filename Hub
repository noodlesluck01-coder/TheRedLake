local lastDeployTry = 0

-- downed = SecondChance panel ("PRESS G OR CLICK TO GET UP") visible;
-- downMechanic.Enabled is always true, so it is NOT a downed signal
local function downedVisible()
    local pg = plr:FindFirstChild("PlayerGui")
    if not pg then return false end
    local cp = pg:FindFirstChild("CardPick")
    local sc = cp and cp:FindFirstChild("Root") and cp.Root:FindFirstChild("SecondChance")
    return (sc and sc.Visible) and true or false
end

-- deploy — remote-first, straight out of the decompiled SafehouseBar:
-- the game refuses EVERY deploy (button clicks included) while
--   * a vote is running          (GameStatus.BlockExit.Value == true)
--   * the map vote is unresolved (ReplicatedStorage.Map ObjectValue = nil)
-- and the deploy itself is just Remotes.DeployRequest:FireServer().
local deployWaitNote = 0
local voteWaitNote = 0
local function tryDeploy()
    if tick() - lastDeployTry < 3 then return false end
    lastDeployTry = tick()
    local pg = plr:FindFirstChild("PlayerGui")
    if not pg then return false end
    -- DEATH WISH penalty: dying forces a countdown ("YOU CAN DEPLOY IN Xs")
    -- while the deploy button is LOCKED. Pressing during Wait is pointless,
    -- so hold off until the countdown frame hides.
    local ds = pg:FindFirstChild("DeathScreen")
    if ds and ds.Root then
        local wt = ds.Root:FindFirstChild("Wait")
        if wt and wt.Visible then
            if tick() - deployWaitNote >= 10 then
                deployWaitNote = tick()
                print("[farm v2] death screen deploy timer running - waiting it out")
            end
            return false
        end
    end
    -- the game's own deploy blocking states (decompiled SafehouseBar)
    local RS = game:GetService("ReplicatedStorage")
    local mapObj = RS:FindFirstChild("Map")
    local mapOk = false
    if mapObj and mapObj:IsA("ObjectValue") then
        local mv = mapObj.Value
        if mv and mv.Parent then mapOk = true end
    end
    if not mapOk then
        if tick() - voteWaitNote >= 10 then
            voteWaitNote = tick()
            print("[farm v2] deploy blocked: map vote not finished - clicking votes first")
        end
        return false -- modernVoteTick keeps pressing the vote cards meanwhile
    end
    local gs = RS:FindFirstChild("GameStatus")
    local bx = gs and gs:FindFirstChild("BlockExit")
    if bx and bx.Value == true then
        if tick() - voteWaitNote >= 10 then
            voteWaitNote = tick()
            print("[farm v2] deploy blocked: a vote is running")
        end
        return false
    end
    -- deploy via the remote (no clicks needed, works from the death screen too)
    local rem = RS:FindFirstChild("Remotes")
    local dr = rem and rem:FindFirstChild("DeployRequest")
    if dr and workspace:GetAttribute("DeployRequestOff") ~= true
        and notDeployedNow() then
        stats.deploys += 1
        lastDeployTry = tick() + 9
        dr:FireServer()
        print("[farm v2] DeployRequest fired (deploy #" .. stats.deploys .. ")")
        return true
    end
    -- fallback: the HUD bar button (works fine once nothing is blocked)
    local btn = getCachedDeploy(pg)
    if btn and notDeployedNow() then
        if pressButton(btn) then
            stats.deploys += 1
            -- one press per ~12s: TRL queues one spawn per click
            lastDeployTry = tick() + 9
            print("[farm v2] pressed deploy (deploy #" .. stats.deploys .. ")")
            return true
        end
    end
    -- downed: only touch panels when SecondChance is actually visible
    if downedVisible() then
        local dm = pg:FindFirstChild("downMechanic")
        if dm then
            local rsp = dm:FindFirstChild("Respawn")
            local rspBtn = rsp and rsp:FindFirstChild("Button")
            if rspBtn and rspBtn.Visible then
                if pressButton(rspBtn) then
                    print("[farm v2] pressed downed Respawn")
                    return true
                end
            end
        end
    end
    for _, name in ipairs({ "RespawnChoice", "RapidDeployUI", "TacticalSpawnWindow", "DeathScreen", "Death" }) do
        local gui = pg:FindFirstChild(name)
        if gui and gui.Enabled and pressByText(gui, { "play", "deploy", "respawn", "redeploy", "continue", "resume" }) then
            stats.deploys += 1
            print("[farm v2] pressed respawn/lobby deploy in " .. name .. " (deploy #" .. stats.deploys .. ")")
            return true
        end
    end
    return false
end

-- revive: CLICK the SecondChance button (no key presses at all: the G key
-- is also the ability key and the farm must never use abilities)
local function respawnClick()
    if not downedVisible() then return false end
    local pg = plr:FindFirstChild("PlayerGui")
    if not pg then return false end
    local cp = pg:FindFirstChild("CardPick")
    local sc = cp and cp:FindFirstChild("Root") and cp.Root:FindFirstChild("SecondChance")
    if sc and sc.Visible then
        if pressButton(sc) then
            print("[farm v2] clicked SecondChance (got up)")
            return true
        end
    end
    for _, name in ipairs({ "RespawnChoice", "DeathScreen", "Death", "downMechanic" }) do
        local gui = pg:FindFirstChild(name)
        if gui and gui.Enabled then
            local hit = pressByText(gui, { "respawn", "redeploy", "deploy", "continue", "resume" })
            if hit then
                print("[farm v2] respawn clicked in " .. name)
                return true
            end
        end
    end
    return false
end

-- vote auto-click while a vote gui is visible. matching: short tokens
-- ("on"/"off"/"354") match as whole words so they never hit "zone",
-- "connection" etc.; longer tokens (easy/medium/brutal/forest/desert)
-- match as plain substring (case-insensitive, txt is lowercased)
local function voteMatches(txt, target)
    if #target <= 3 then
        local hit = txt:match("%f[%w]" .. target .. "%f[%W]")
        return hit ~= nil
    end
    return txt:find(target, 1, true) ~= nil
end

local pressGate = {}

-- LIVE vote casting through the remotes the game itself uses (decompiled
-- GameMain.Voting.VoteCreator): every vote answer is
--     AssignVote:InvokeServer(voteName, optionName)
-- Votes arrive as Template clones in GameMain.Voting (clone Name = vote
-- name, its Votes container holds one option frame per choice). Remote
-- casting sidesteps the ally band entirely - its pills are textless icon
-- buttons no text matcher can ever read.
local function remoteVoteTick(pg, normalTargets, allyTargets)
    local RS = game:GetService("ReplicatedStorage")
    local rem = RS:FindFirstChild("Remotes")
    local cv = rem and rem:FindFirstChild("CreateVote")
    local av = cv and cv:FindFirstChild("AssignVote")
    if not av then return false end
    local gm = pg:FindFirstChild("GameMain")
    local voting = gm and gm:FindFirstChild("Voting")
    if not voting then return false end

    local acted = false
    for _, clone in ipairs(voting:GetChildren()) do
        if acted then break end
        if clone:IsA("GuiObject") and clone.Name ~= "Template" then
            local voteName = clone.Name
            local lname = string.lower(voteName)
            local isAlly = lname:find("ally", 1, true) ~= nil
            local targets = isAlly and allyTargets or normalTargets
            if isAlly and #allyTargets == 0 then
                -- ally votes left manual ("Leave to me")
            elseif not isAlly and #normalTargets == 0 then
                -- Auto / Any / Any votes untouched
            else
                local votesRow = clone:FindFirstChild("Votes") or clone
                for _, opt in ipairs(votesRow:GetChildren()) do
                    if acted then break end
                    if opt:IsA("Frame") and opt:FindFirstChild("VoteFrame") then
                        local composed = " " .. string.lower(opt.Name) .. " "
                        for _, c in ipairs(opt:GetDescendants()) do
                            if c:IsA("TextLabel") then
                                local t = string.lower(tostring(c.Text))
                                if t ~= "vote" and t ~= "0" then
                                    composed = composed .. t .. " "
                                end
                            end
                        end
                        -- level-locked options are not selectable
                        if not string.find(composed, "level %d", 1, false) then
                            local matched = nil
                            for _, t in ipairs(targets) do
                                if voteMatches(composed, t) then
                                    matched = t
                                    break
                                end
                            end
                            if matched then
                                local now2 = tick()
                                local g = pressGate["REM " .. voteName]
                                if not g or now2 - g >= 2 then
                                    pressGate["REM " .. voteName] = now2
                                    local okSend = pcall(function()
                                        av:InvokeServer(voteName, opt.Name)
                                    end)
                                    acted = true
                                    print("[farm v2] remote vote '" .. voteName
                                        .. "' -> '" .. tostring(matched)
                                        .. "' (" .. opt.Name .. ") ok=" .. tostring(okSend))
                                else
                                    acted = true
                                end
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    return acted
end

-- modern voting (GameMain.ModernVoting): each option is an Option-frame
-- holding a textless VoteFrame/Button; the option's NAME and its own
-- TextLabels carry the words (AREA 354 (CLASSIC) / FOREST / DESERT /
-- BRUTAL / DEATH WISH / CLASSIC BRUTAL...). One press per 2s, and the
-- "CLASSIC BRUTAL" deathwish-standard card is never mistaken for the
-- difficulty "BRUTAL".
local function modernVoteTick(pg)
    local gm = pg:FindFirstChild("GameMain")
    if not gm then return false end
    local mv = gm:FindFirstChild("ModernVoting")
    if not (mv and mv.Visible) then return false end
    -- vote cards idle on screen even mid-match: only click while we are
    -- actually in the lobby/menu (the deploy bar or MenuStage is up), so
    -- combat never receives stray vote presses
    if not menuOpen() then return false end

    local pressed = false
    for _, opt in ipairs(mv:GetDescendants()) do
        if pressed then break end
        if opt:IsA("Frame") then
            local vf = opt:FindFirstChild("VoteFrame")
            local btn = opt:FindFirstChild("Button") or (vf and vf:FindFirstChild("Button"))
            if btn and btn:IsA("GuiButton") and chainVisible(btn) then
                local composed = " " .. string.lower(opt.Name) .. " "
                for _, c in ipairs(opt:GetDescendants()) do
                    if c:IsA("TextLabel") then
                        local t = string.lower(tostring(c.Text))
                        if t ~= "vote" and t ~= "0" then
                            composed = composed .. t .. " "
                        end
                    end
                end
                local isDwOpt = composed:find("deathwish", 1, true) ~= nil
                    or composed:find("death wish", 1, true) ~= nil

                -- 1) DEATH WISH vote (On / Off), only when configured
                if cfg.deathwish == "On" and isDwOpt
                    and not composed:find("classic brutal", 1, true) then
                    local now = tick()
                    local g = pressGate["ModernDeathwish"]
                    if not g or now - g >= 2 then
                        pressGate["ModernDeathwish"] = now
                        pressButton(btn)
                        pressed = true
                        print("[farm v2] voted DEATH WISH on")
                    else
                        pressed = true
                    end
                elseif cfg.deathwish == "Off" and not isDwOpt
                    and composed:find("standard", 1, true) then
                    local now = tick()
                    local g = pressGate["ModernDeathwish"]
                    if not g or now - g >= 2 then
                        pressGate["ModernDeathwish"] = now
                        pressButton(btn)
                        pressed = true
                        print("[farm v2] voted death wish off (classic brutal)")
                    else
                        pressed = true
                    end

                -- 2) difficulty / map / versus: never touch the death-wish pair
                elseif not isDwOpt and not composed:find("classic brutal", 1, true) then
                    for _, t in ipairs(normalTargets) do
                        if voteMatches(composed, t) then
                            local now = tick()
                            local g = pressGate["ModernVote"]
                            if not g or now - g >= 2 then
                                pressGate["ModernVote"] = now
                                pressButton(btn)
                                pressed = true
                                print("[farm v2] vote click '" .. tostring(t)
                                    .. "' (ModernVoting." .. opt.Name .. ")")
                            else
                                pressed = true
                            end
                            break
                        end
                    end
                end
            end
        end
    end
    return pressed
end

local function voteTick()
    local pg = plr:FindFirstChild("PlayerGui")
    if not pg then return end
    -- ally votes get their OWN target list, so difficulty/map/versus tokens
    -- can never misclick inside the ally frames (and vice versa)
    local normalTargets, allyTargets = {}, {}
    if cfg.difficulty ~= "Auto" then table.insert(normalTargets, string.lower(cfg.difficulty)) end
    if cfg.map ~= "Any" then table.insert(normalTargets, string.lower(cfg.map)) end
    if cfg.versus == "On" then table.insert(normalTargets, "on") end
    if cfg.versus == "Off" then table.insert(normalTargets, "off") end
    if cfg.ally ~= "Any" then
        -- ally buttons are labelled after the allied group (GOC / MCD a.k.a.
        -- Marshall Carter & Dark / UIU) or the pass option ("None"/"No ally")
        local ALLY_TOKENS = {
            GOC = { "goc" },
            MCD = { "mcd", "mc&d", "marshall", "carter", "daugh" },
            UIU = { "uiu" },
            ["None"] = { "none", "no ally", "noallies", "solo" },
        }
        local toks = ALLY_TOKENS[cfg.ally]
        if toks then
            for _, t in ipairs(toks) do table.insert(allyTargets, t) end
        end
    end
    -- primary: cast live votes through the game's own AssignVote remote
    -- (works for the textless ally pills); on any cast/gate this tick the
    -- UI clickers below are skipped so we never double-vote
    if remoteVoteTick(pg, normalTargets, allyTargets) then return end

    -- modern voting click fallback (GameMain.ModernVoting). When it
    -- consumed this tick (pressed or 2s-gated) the legacy vote frames are
    -- skipped so we never double-press the same election.
    local modernBusy = modernVoteTick(pg)

    -- legacy/name vote guis: every enabled ScreenGui whose name contains
    -- "vote" (VoteStepper / VoteReveal / AllyVote / Ext*Vote) +
    -- MenuOperatives (ally faction roster buttons: GOC / MCD / UIU).
    local frames = {}
    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled
            and string.find(string.lower(gui.Name), "vote", 1, true) then
            table.insert(frames, gui)
        end
    end
    local mOper = pg:FindFirstChild("MenuOperatives")
    if mOper and mOper.Enabled then table.insert(frames, mOper) end

    if modernBusy then return end
    for _, gui in ipairs(frames) do
        local name = gui.Name
        local lname = string.lower(name)
        local isAlly = lname:find("ally", 1, true) ~= nil or name == "MenuOperatives"
        if isAlly and #allyTargets == 0 then
            -- ally mode "Leave to me": ally frames stay manual
        elseif not isAlly and #normalTargets == 0 then
            -- Auto / Any / Any: nothing to click in the normal votes
        else
            local targets = isAlly and allyTargets or normalTargets
            local pressedFrame = false
            for _, d in ipairs(gui:GetDescendants()) do
                if isAlly and pressedFrame then break end
                if (d:IsA("TextButton") or d:IsA("GuiButton")) and chainVisible(d) then
                    local txt = ""
                    pcall(function() txt = string.lower(tostring(d.Text)) end)
                    for _, t in ipairs(targets) do
                        if voteMatches(txt, t) then
                            -- ally frames: max 1 press per 2s (never spam
                            -- a post-vote "Allied!" state text)
                            local now = tick()
                            if not isAlly
                                or (not pressGate[name] or now - pressGate[name] >= 2) then
                                pressButton(d)
                                pressGate[name] = now
                                if isAlly then pressedFrame = true end
                                print("[farm v2] vote click '" .. tostring(d.Text) .. "' (" .. name .. ")")
                            end
                            break
                        end
                    end
                end
            end
            -- telemetry: ally vote open but no faction button matched
            -- (e.g. the CHOOSE AN ALLY band's pills are textless icons) -
            -- log it once so the missing token/structure can be fixed
            if isAlly and not pressedFrame then
                local now = tick()
                local gate = pressGate[name .. "-miss"]
                if not gate or now - gate >= 6 then
                    pressGate[name .. "-miss"] = now
                    print("[farm v2] " .. name .. " open - no faction button matched ("
                        .. table.concat(allyTargets, "/") .. ")")
                end
            end
        end
    end
end

