-- ================================================================
-- GENERATOR TARGETING (permanent rule, no toggle button)
-- Every target pick (silent aim, kill closest, axe aura) ranks
-- enemies by their distance to THE GENERATOR — the thing enemies
-- actually attack. The generator is auto-found on every map; when a
-- map has none, everything silently falls back to closest-to-player.
-- ================================================================
local generatorRef = nil
local generatorPos = nil
local findFailedAt = nil

local function findGenerator()
    -- fast path known for this game: Workspace.GeneratorFolder.GeneratorPart
    local folder = workspace:FindFirstChild("GeneratorFolder")
    if folder then
        local part = folder:FindFirstChild("GeneratorPart")
        if part and part:IsA("BasePart") then
            generatorRef, generatorPos = part, part.Position
            return true
        end
        local any = folder:FindFirstChildWhichIsA("BasePart", true)
        if any then
            generatorRef, generatorPos = any, any.Position
            return true
        end
    end
    -- generic fallback: any generator-named part/model in the map
    local now = tick()
    if findFailedAt and (now - findFailedAt) < 10 then
        return generatorRef ~= nil   -- don't rescan the whole map constantly after a miss
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        local ln = string.lower(d.Name)
        if ln:find("generator", 1, true)
            and (d:IsA("BasePart") or d:IsA("Model"))
            and ln:find("danger", 1, true) == nil
            and ln:find("manager", 1, true) == nil then
            if d:IsA("BasePart") then
                generatorRef, generatorPos = d, d.Position
                break
            elseif d:IsA("Model") then
                local p = d:FindFirstChildWhichIsA("BasePart")
                if p then
                    generatorRef, generatorPos = p, p.Position
                    break
                end
            end
        end
    end
    if not generatorRef then
        findFailedAt = now
        return false
    end
    return true
end

-- make sure the reference is still valid (maps get replaced/destroyed)
local function ensureGenerator()
    if not generatorRef or not generatorRef.Parent then
        generatorRef, generatorPos = nil, nil
        findGenerator()
    end
end

-- new map spawned: a fresh GeneratorFolder appears — notice it cheaply
workspace.ChildAdded:Connect(function(child)
    if child.Name == "GeneratorFolder" then
        findGenerator()
    end
end)
findGenerator()
print("[✓] Generator targeting: " .. (generatorRef and ("on (" .. tostring(math.floor(generatorPos.X)) .. ", " .. tostring(math.floor(generatorPos.Y)) .. ", " .. tostring(math.floor(generatorPos.Z)) .. ")") or "no generator on this map yet — will auto-find"))

-- ================================================================
-- FRIENDLY-FIRE GUARD (permanent) — players are NEVER targets.
-- A teammate who spawned as a lake monster still owns a real Player
-- Character and gets tagged like an NPC for pathing; without this the
-- aura/aim/ESP treat him as food. Any model owned by a Player is
-- skipped everywhere (enemy waves are NPC-owned, they stay targetable).
-- Hardened: also catches spawned player-owned NPCs (shapeshifter/card
-- morphs) via attribute ownership links, ObjectValue owners, Friends/
-- Survivors folders and the "Friend" collection tag.
-- ================================================================
local function isPlayerOwned(model)
    if not model then return false end

    -- 1) direct player character
    local ok, owner = pcall(function() return players:GetPlayerFromCharacter(model) end)
    if ok and owner then return true end

    -- live player lookups (name, display name, user id)
    local byName, byId = {}, {}
    pcall(function()
        for _, p in ipairs(players:GetPlayers()) do
            byName[p.Name] = true
            byName[p.DisplayName] = true
            byId[p.UserId] = true
        end
    end)

    -- 2) attribute markers (shapeshifter / card-spawned ownership links)
    local linked = false
    pcall(function()
        for k, v in pairs(model:GetAttributes()) do
            local lk = string.lower(k)
            if type(v) == "string" and v ~= "" and byName[v] then
                linked = true
            elseif type(v) == "number" and byId[v]
                and (lk:find("user") or lk:find("owner") or lk:find("player") or lk:find("team")) then
                linked = true
            end
        end
    end)
    if linked then return true end

    -- 3) any value object inside the model pointing at a player
    pcall(function()
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("ObjectValue") then
                if typeof(d.Value) == "Instance" and d.Value:IsA("Player") then
                    linked = true
                end
            elseif d:IsA("StringValue") then
                if d.Value ~= "" and byName[d.Value] then
                    linked = true
                end
            elseif d:IsA("NumberValue") or d:IsA("IntValue") then
                local dk = string.lower(d.Name)
                if byId[d.Value]
                    and (dk:find("user") or dk:find("owner") or dk:find("player") or dk:find("team")) then
                    linked = true
                end
            end
            if linked then return end
        end
    end)
    if linked then return true end

    -- 4) friendly collections
    local par = model.Parent
    if par and (par.Name == "Friends" or par.Name == "Survivors") then return true end
    local okt, tags = pcall(function() return game:GetService("CollectionService"):GetTags(model) end)
    if okt and tags then
        for _, t in ipairs(tags) do
            if string.lower(t) == "friend" then return true end
        end
    end
    return false
end

-- ================================================================
-- SINGLE ENEMY CACHE
-- ================================================================
local enemyCache = {}
local cacheTimestamp = 0
local CACHE_DURATION = 0.25   -- was 0.5: faster target switching

local function refreshEnemyCache()
    local now = tick()
    if now - cacheTimestamp < CACHE_DURATION then
        return enemyCache
    end
    cacheTimestamp = now

    local newCache = {}
    if npcFolder then
        for _, v in ipairs(npcFolder:GetChildren()) do
            if v.Name == "Tango" or v.Name == "Monsters" then
                for _, k in ipairs(v:GetChildren()) do
                    if k:IsA("Model") and k:FindFirstChild("HumanoidRootPart") and not isPlayerOwned(k) then
                        local humanoid = k:FindFirstChild("Humanoid")
                        if humanoid and humanoid.Health > 0 then
                            table.insert(newCache, k)
                        end
                    end
                end
            end
        end
    end

    enemyCache = newCache
    return enemyCache
end

local function getclosestenemy()
    local enemies = refreshEnemyCache()
    if #enemies == 0 then return nil end

    local char = plr.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local playerPos = hrp and hrp.Position or nil

    ensureGenerator()

    local closest = nil
    local bestKey = math.huge

    for _, k in ipairs(enemies) do
        local targetHrp = k:FindFirstChild("HumanoidRootPart")
        if targetHrp then
            local key
            if generatorPos then
                -- PERMANENT RULE: rank by distance to the generator
                key = (targetHrp.Position - generatorPos).Magnitude
            elseif playerPos then
                -- no generator on this map: closest to player
                key = (targetHrp.Position - playerPos).Magnitude
            end
            if key and key < bestKey then
                closest = k
                bestKey = key
            end
        end
    end
    return closest
end

-- ================================================================
-- CACHED TOOL / REMOTE
-- ================================================================
local cachedTool = nil
local cachedRemote = nil

local function getTool()
    local char = plr.Character
    if not char then return nil end
    if cachedTool and cachedTool.Parent == char then
        return cachedTool
    end
    cachedTool = char:FindFirstChildOfClass("Tool")
    if cachedTool then
        cachedRemote = cachedTool:FindFirstChild("Main")
    else
        cachedRemote = nil
    end
    return cachedTool
end

local function getAmmo()
    local gui = plr.PlayerGui
    if not gui then return 999 end
    local crosshair = gui:FindFirstChild("Crosshair")
    if not crosshair then return 999 end
    local counter = crosshair:FindFirstChild("Counter")
    if not counter then return 999 end
    local stored = counter:FindFirstChild("StoredAmmo")
    if not stored then return 999 end
    return tonumber(stored.Text) or 999
end

-- ================================================================
-- COMBAT TOGGLES (throttled, stop in <100ms on toggle off, idle when dead)
-- ================================================================

-- interruptible sleep: wakes every `slice` so toggling OFF takes effect fast,
-- but still respects the throttle rate (no busy-waiting)
local function sleepWhile(cond, seconds, slice)
    local deadline = tick() + seconds
    while cond() and tick() < deadline do
        task.wait(slice or 0.02)
    end
end

local function charAlive()
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

-- shots fired counter (for tuning/verification)
local shotCount = { silent = 0, kill = 0 }

-- target must still be alive, else force a cache rescan immediately
local function validTarget(target)
    if not target or not target.Parent then return false end
    local hum = target:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then
        cacheTimestamp = 0
        return false
    end
    return target:FindFirstChild("Head") ~= nil
end

-- Silent Aim
local silentAimOn = false
local silentAimLoop = false
local SILENT_AIM_RATE = 0.02   -- ~50 shots/sec (maxed out)
local IDLE_WAIT = 0.4          -- dead / no weapon = near-zero activity

local function setSilentAim(state)
    silentAimOn = state
    if not state or silentAimLoop then return end
    silentAimLoop = true

    task.spawn(function()
        while silentAimOn do
            if not charAlive() then
                sleepWhile(function() return silentAimOn end, IDLE_WAIT, 0.05)
                continue
            end

            local tool = getTool()
            local remote = cachedRemote
            if not tool or not remote then
                sleepWhile(function() return silentAimOn end, IDLE_WAIT, 0.05)
                continue
            end

            local target = getclosestenemy()
            if not validTarget(target) then
                sleepWhile(function() return silentAimOn end, 0.05)
                continue
            end

            local head = target:FindFirstChild("Head")
            shotCount.silent += 1
            pcall(function()
                remote:FireServer("DAMAGE", {head, head.Position, 0, false})
            end)
            sleepWhile(function() return silentAimOn end, SILENT_AIM_RATE)
        end
        silentAimLoop = false
    end)
end

-- Kill Closest
local killClosestOn = false
local killClosestLoop = false
local KILL_RATE = 0.015         -- ~66 swings/sec (maxed out)

local function setKillClosest(state)
    killClosestOn = state
    if not state or killClosestLoop then return end
    killClosestLoop = true

    task.spawn(function()
        while killClosestOn do
            if not charAlive() then
                sleepWhile(function() return killClosestOn end, IDLE_WAIT, 0.05)
                continue
            end

            local tool = getTool()
            local remote = cachedRemote
            if not tool or not remote then
                sleepWhile(function() return killClosestOn end, IDLE_WAIT, 0.05)
                continue
            end

            local target = getclosestenemy()
            if not validTarget(target) then
                sleepWhile(function() return killClosestOn end, 0.05)
                continue
            end

            local head = target:FindFirstChild("Head")
            local ammo = getAmmo()

            -- DAMAGE always fires (this is what kills); ammo only gates the
            -- cosmetic shot-feel calls, so low reserve never stalls the aura
            shotCount.kill += 1
            pcall(function()
                remote:FireServer("DAMAGE", {head, head.Position, 0, false})
                if ammo and ammo >= 10 then
                    remote:FireServer("AMMO")
                    local handle = tool:FindFirstChild("Handle")
                    if handle then
                        local barrel = handle:FindFirstChild("Barrel")
                        if barrel then
                            remote:FireServer("MUZZLE", barrel)
                        end
                    end
                end
            end)

            sleepWhile(function() return killClosestOn end, KILL_RATE)
        end
        killClosestLoop = false
    end)
end

-- ONE button drives both (user request: same button)
local function setCombat(state)
    setSilentAim(state)
    setKillClosest(state)
end

