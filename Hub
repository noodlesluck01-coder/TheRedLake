-- TANZANITE AXE TAB (native)
-- The old toggles loaded MoonSec-obfuscated remote scripts that now
-- die instantly inside their VM: "attempt to index nil with 'Main'".
-- These use the axe's own client protocol instead (verified live):
--   SWING:   Main:FireServer("SWING", {})
--   DAMAGE:  Main:FireServer("DAMAGE", { enemyModel })
--   CHARGE:  Main:FireServer("CHARGE", { seconds })   (2..8)
--   5th combo: Main:FireServer("AxeExplode", {})
-- Enemies come from CollectionService tags "Tango"/"Monster"
-- (what the axe itself targets). Server accepted DAMAGE from 700+
-- studs away, so no distance gating is needed.
-- ================================================================
local CollectionService = game:GetService("CollectionService")

local function getCharAxe()
    local char = plr.Character
    if not char then return nil end
    -- Tanzanite Axe first, then any other axe variant
    local a = char:FindFirstChild("Tanzanite Axe")
    if a then return a end
    local held = char:FindFirstChildOfClass("Tool")
    if held and held.Name:find("Axe", 1, true) then return held end
    return nil
end

-- enemies via the same tags the axe's own client scans
-- PERMANENT RULE: sorted by distance to the generator (falls back to
-- player distance only on maps without one). The "dist" field stays
-- = distance to PLAYER (used by the close-swing check below).
local function collectTargets(tags)
    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    ensureGenerator()
    local out = {}
    for _, tag in ipairs(tags) do
        for _, m in ipairs(CollectionService:GetTagged(tag)) do
            local root = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChild("Humanoid")
            if root and hum and hum.Health > 0 and not (m:GetAttribute("HitByClient") or false) and not isPlayerOwned(m) then
                table.insert(out, {
                    model = m,
                    dist = hrp and (root.Position - hrp.Position).Magnitude or 9e9,
                    gen = generatorPos and (root.Position - generatorPos).Magnitude or nil,
                })
            end
        end
    end
    if generatorPos and #out > 0 then
        table.sort(out, function(a, b) return a.gen < b.gen end)
    else
        table.sort(out, function(a, b)
            return a.dist < b.dist
        end)
    end
    return out
end

-- one aura cycle (measured live: constant 2.0s cycle keeps swings accepted):
--  - close target  -> real tool:Activate() swing (free, no meter usage)
--  - far targets   -> raw SWING + DAMAGE + AxeExplode packets (accepted at
--    any distance by the server)
-- the aura never teleports or moves you.
local function axeAuraCycle(tags)
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hum and hum.Health > 0) then return end
    local axe = getCharAxe()
    if not axe then
        -- auto-equip from the backpack (Tanzanite Axe, then any Axe variant)
        local bp = plr:FindFirstChildOfClass("Backpack")
        local a2 = bp and (bp:FindFirstChild("Tanzanite Axe") or bp:FindFirstChild("Axe"))
        if a2 then pcall(function() hum:EquipTool(a2) end) end
        return
    end
    if not axe:FindFirstChild("Main") then return end
    if (axe:GetAttribute("Uses") or 0) <= 0 then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local targets = collectTargets(tags)
    if #targets == 0 then return end

    -- close range: actual swing, always works
    if targets[1].dist <= (axe:GetAttribute("Range") or 10) + 2 then
        pcall(function() axe:Activate() end)
        task.wait(0.9)
        return
    end

    -- far: raw packets, keeps whole map reachable
    local maxTargets = axe:GetAttribute("MaxTargets") or 3
    local chosen = {}
    for i = 1, math.min(maxTargets, #targets) do
        table.insert(chosen, targets[i])
    end
    local mainEvent = axe:FindFirstChild("Main")
    mainEvent:FireServer("SWING", {})
    task.wait(0.07)
    for _, t in ipairs(chosen) do
        if t.model.Parent then
            pcall(function()
                mainEvent:FireServer("DAMAGE", { t.model })
            end)
        end
    end
    pcall(function()
        mainEvent:FireServer("AxeExplode", {})
    end)
end

local function startAuraLoop(getState, tags, label)
    task.spawn(function()
        while getState() do
            local ok, err = pcall(axeAuraCycle, tags)
            if not ok then
                warn("[notveryuhq] " .. label .. " error: " .. tostring(err))
            end
            sleepWhile(getState, 0.45)  -- ~1 swing / 0.9s (in-game Cooldown is 0.8)
        end
    end)
end

