-- ================================================================
-- OPEN ONLY Combat / Visuals / Misc AT START
-- Mercury hides tab buttons until you click a quick-access icon on
-- the home page. Reveal just our 3 tabs in the nav bar and open
-- Combat. Settings / Credits are NOT deleted: they stay reachable
-- through the home-page gear / credits icons, but their nav buttons
-- are kept hidden — even if something tries to reveal them later.
-- ================================================================
local startupOk, startupErr = pcall(function()
    local wanted = { Combat = true, Visuals = true, Misc = true }
    local nav = window.navigation.AbsoluteObject
    local nilFolder = window.nilFolder and window.nilFolder.AbsoluteObject
    local activePage = nil

    for _, info in ipairs(window.Tabs) do
        local page, btn, name = info[1], info[2], info[3]
        if name and wanted[name] then
            -- reveal only our 3 tab buttons in the nav bar
            btn.Parent = nav
            btn.Visible = true
            if name == "Combat" then
                activePage = page
            end
        elseif name then
            -- Settings / Credits: pull out of the nav and keep hidden.
            -- If the home-page gear/credits icon reveals them again the
            -- button is hidden instantly — the page itself still opens,
            -- so Settings/Credits remain fully usable.
            pcall(function()
                btn.Visible = false
                if nilFolder then
                    btn.Parent = nilFolder
                end
                btn:GetPropertyChangedSignal("Visible"):Connect(function()
                    if btn.Visible then
                        task.defer(function()
                            btn.Visible = false
                        end)
                    end
                end)
            end)
        end
    end

    -- fallback: first wanted tab if Combat wasn't found
    if not activePage then
        for _, info in ipairs(window.Tabs) do
            if wanted[info[3]] then
                activePage = info[1]
                break
            end
        end
    end

    -- show only the active page (pages overlap, so only one can show)
    for _, info in ipairs(window.Tabs) do
        if info[3] then
            info[1].Visible = (info[1] == activePage)
        end
    end
    if window.homePage then
        window.homePage.Visible = false
    end

    -- selected button = solid, the rest = transparent
    for _, info in ipairs(window.Tabs) do
        local page, btn, name = info[1], info[2], info[3]
        if name and wanted[name] then
            btn.BackgroundTransparency = (page == activePage) and 0 or 1
        end
    end

    -- deselect the home button so only Combat reads as active
    if window.homeButton then
        window.homeButton.BackgroundTransparency = 1
    end

    -- keep the address bar in sync
    pcall(function()
        window.UrlLabel.Text = window.Url .. "/combat"
    end)
end)
if not startupOk then
    warn("[notveryuhq] tab reveal failed: " .. tostring(startupErr))
end

