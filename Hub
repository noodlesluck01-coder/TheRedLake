local ui
local function buildUI()
    pcall(function()
        local old = plr:FindFirstChild("PlayerGui") and plr.PlayerGui:FindFirstChild("BIOSYN_Farm")
        if old then old:Destroy() end
        if game.CoreGui then
            local oldCore = game.CoreGui:FindFirstChild("BIOSYN_Farm")
            if oldCore then oldCore:Destroy() end
        end
    end)

    ui = Instance.new("ScreenGui")
    ui.Name = "BIOSYN_Farm"
    pcall(function() ui.Parent = game.CoreGui end)
    if not ui.Parent then
        ui.Parent = plr:WaitForChild("PlayerGui")
    end
    ui.ResetOnSpawn = false
    ui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ui.DisplayOrder = 50
    uiHolder.handle = ui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 210, 0, 250)
    frame.Position = UDim2.new(0, 18, 0, 180)
    frame.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = ui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -12, 0, 22)
    title.Position = UDim2.new(0, 8, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = "BIOSYN Auto-Farm (v2)"
    title.TextColor3 = Color3.fromRGB(255, 190, 60)
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13
    title.Parent = frame

    local status = Instance.new("TextLabel")
    status.Name = "Status"
    status.Size = UDim2.new(1, -12, 0, 18)
    status.Position = UDim2.new(0, 8, 0, 26)
    status.BackgroundTransparency = 1
    status.Text = "OFF"
    status.TextColor3 = Color3.fromRGB(200, 200, 200)
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.Font = Enum.Font.Gotham
    status.TextSize = 11
    status.Parent = frame

    local function makeButton(y, label, cb)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -16, 0, 26)
        b.Position = UDim2.new(0, 8, 0, y)
        b.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
        b.BorderSizePixel = 0
        b.Text = label
        b.TextColor3 = Color3.fromRGB(235, 235, 235)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.Parent = frame
        local c2 = Instance.new("UICorner")
        c2.CornerRadius = UDim.new(0, 6)
        c2.Parent = b
        b.MouseButton1Click:Connect(cb)
        return b
    end

    -- dropdown rows: difficulty / map / versus - selections feed the vote
    -- auto-clicker (voteTick matches the real vote button text)
    local openDropdown = nil
    local function makeDropdown(y, labelText, options, displayLabel, onChange)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0, 60, 0, 24)
        lbl.Position = UDim2.new(0, 8, 0, y)
        lbl.BackgroundTransparency = 1
        lbl.Text = labelText
        lbl.TextColor3 = Color3.fromRGB(170, 170, 170)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 11
        lbl.Parent = frame

        local valueBtn = Instance.new("TextButton")
        valueBtn.Size = UDim2.new(0, 130, 0, 24)
        valueBtn.Position = UDim2.new(0, 72, 0, y)
        valueBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
        valueBtn.BorderSizePixel = 0
        valueBtn.Text = displayLabel
        valueBtn.TextColor3 = Color3.fromRGB(235, 235, 235)
        valueBtn.Font = Enum.Font.GothamBold
        valueBtn.TextSize = 11
        valueBtn.TextTruncate = Enum.TextTruncate.AtEnd
        valueBtn.ZIndex = 3
        valueBtn.Parent = frame
        local vc = Instance.new("UICorner")
        vc.CornerRadius = UDim.new(0, 5)
        vc.Parent = valueBtn

        local list = Instance.new("Frame")
        list.Size = UDim2.new(0, 130, 0, #options * 22)
        list.Position = UDim2.new(0, 72, 0, y + 26)
        list.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
        list.BorderSizePixel = 0
        list.Visible = false
        list.ZIndex = 20
        list.Parent = frame
        local lc = Instance.new("UICorner")
        lc.CornerRadius = UDim.new(0, 5)
        lc.Parent = list

        valueBtn.MouseButton1Click:Connect(function()
            if openDropdown and openDropdown ~= list then
                openDropdown.Visible = false
            end
            list.Visible = not list.Visible
            openDropdown = list.Visible and list or nil
        end)

        for i, opt in ipairs(options) do
            local o = Instance.new("TextButton")
            o.Size = UDim2.new(1, -4, 0, 20)
            o.Position = UDim2.new(0, 2, 0, (i - 1) * 22)
            o.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
            o.BorderSizePixel = 0
            o.Text = opt.label
            o.TextColor3 = Color3.fromRGB(225, 225, 225)
            o.Font = Enum.Font.Gotham
            o.TextSize = 11
            o.TextXAlignment = Enum.TextXAlignment.Left
            o.ZIndex = 22
            o.Parent = list
            local oc = Instance.new("UICorner")
            oc.CornerRadius = UDim.new(0, 4)
            oc.Parent = o
            local pad = Instance.new("UIPadding")
            pad.PaddingLeft = UDim.new(0, 7)
            pad.Parent = o
            o.MouseButton1Click:Connect(function()
                valueBtn.Text = opt.label
                onChange(opt.value)
                list.Visible = false
                openDropdown = nil
            end)
        end
    end

    makeDropdown(84, "DIFF", {
        { label = "Auto", value = "Auto" },
        { label = "Easy", value = "Easy" },
        { label = "Medium", value = "Medium" },
        { label = "Brutal (35+)", value = "Brutal" },
    }, cfg.difficulty, function(v)
        cfg.difficulty = v
        saveCfg()
        print("[farm v2] vote cfg: diff=" .. cfg.difficulty .. " map=" .. cfg.map .. " versus=" .. cfg.versus)
    end)

    makeDropdown(110, "MAP", {
        { label = "Any", value = "Any" },
        { label = "Classic (354)", value = "354" },
        { label = "Forest", value = "Forest" },
        { label = "Desert", value = "Desert" },
    }, cfg.map == "354" and "Classic (354)" or cfg.map, function(v)
        cfg.map = v
        saveCfg()
        print("[farm v2] vote cfg: diff=" .. cfg.difficulty .. " map=" .. cfg.map .. " versus=" .. cfg.versus)
    end)

    makeDropdown(136, "VERSUS", {
        { label = "Any", value = "Any" },
        { label = "On", value = "On" },
        { label = "Off", value = "Off" },
    }, cfg.versus, function(v)
        cfg.versus = v
        saveCfg()
        print("[farm v2] vote cfg: diff=" .. cfg.difficulty .. " map=" .. cfg.map .. " versus=" .. cfg.versus)
    end)

    makeDropdown(162, "ALLY", {
        { label = "GOC", value = "GOC" },
        { label = "MCD (Marshall, Carter & Dark)", value = "MCD" },
        { label = "UIU", value = "UIU" },
        { label = "No allies", value = "None" },
        { label = "Leave to me", value = "Any" },
    }, cfg.ally, function(v)
        cfg.ally = v
        saveCfg()
        print("[farm v2] ALLY vote faction: " .. v)
    end)

    makeDropdown(188, "DEATHWISH", {
        { label = "Any (manual)", value = "Any" },
        { label = "On", value = "On" },
        { label = "Off (Classic Brutal)", value = "Off" },
    }, cfg.deathwish, function(v)
        cfg.deathwish = v
        saveCfg()
        print("[farm v2] DEATH WISH vote: " .. v)
    end)

    local toggleBtn
    toggleBtn = makeButton(50, "START FARM", function()
        farmOn = not farmOn
        getgenv().BIOSYN_FARM_AUTORESUME = farmOn
        toggleBtn.Text = farmOn and "STOP FARM" or "START FARM"
        toggleBtn.BackgroundColor3 = farmOn and Color3.fromRGB(50, 88, 50) or Color3.fromRGB(35, 35, 42)
        status.Text = farmOn and ("RUNNING | shots " .. stats.shots) or "OFF"
        print("[farm v2] Auto-Farm " .. (farmOn and "ON" or "OFF"))
    end)

    -- keep the button face in sync when auto-resume boots the farm ON
    if farmOn then
        toggleBtn.Text = "STOP FARM"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 88, 50)
        status.Text = "RUNNING | shots " .. stats.shots
    end

    makeButton(216, "Print status", function()
        print("[farm v2] deploys=" .. stats.deploys .. " deaths=" .. stats.deaths ..
            " shots=" .. stats.shots .. " ammoClaims=" .. stats.claims ..
            " cardPicks=" .. stats.picks .. " streakResets=" .. stats.resets ..
            " | streak now=" .. getStreak() .. "/" .. RESET_STREAK ..
            " | cfg: diff=" .. cfg.difficulty .. " map=" .. cfg.map .. " versus=" .. cfg.versus ..
            " ally=" .. cfg.ally)
    end)

    task.spawn(function()
        while genv.BIOSYN_FARM_RUN_ID == RUN_ID and ui and ui.Parent do
            if farmOn then
                status.Text = string.format("RUNNING | shots %d | streak %d", stats.shots, getStreak())
            end
            task.wait(1)
        end
    end)
end

buildUI()

genv.BIOSYN_FARM = {
    toggle = function(force)
        farmOn = (force == nil) and (not farmOn) or force
        getgenv().BIOSYN_FARM_AUTORESUME = farmOn
        print("[farm v2] Auto-Farm " .. (farmOn and "ON" or "OFF"))
        return farmOn
    end,
    state = function()
        return {
            on = farmOn, build = "farm_v2",
            deploys = stats.deploys, deaths = stats.deaths,
            shots = stats.shots, claims = stats.claims,
            picks = stats.picks, resets = stats.resets,
            streak = getStreak(),
            diff = cfg.difficulty, map = cfg.map, versus = cfg.versus, ally = cfg.ally,
        }
    end,
    setVote = function(diff, versus, map, ally)
        cfg.difficulty = diff or cfg.difficulty
        cfg.versus = versus or cfg.versus
        cfg.map = map or cfg.map
        cfg.ally = ally or cfg.ally
        print("[farm v2] vote cfg: diff=" .. cfg.difficulty .. " vs=" .. cfg.versus
            .. " map=" .. cfg.map .. " ally=" .. cfg.ally)
    end,
    setReset = function(n)
        RESET_STREAK = tonumber(n) or RESET_STREAK
        print("[farm v2] streak auto-reset at " .. RESET_STREAK)
    end,
    setRate = function(n)
        cfg.attackRate = math.max(0.05, tonumber(n) or 0.15)
        print("[farm v2] attack rate set to " .. cfg.attackRate .. "s - reload to apply")
    end,
}

-- Lynx: getgenv() and _G are different tables - expose the API through
-- _G as well so probes / manual calls always work
_G.BIOSYN_FARM = genv.BIOSYN_FARM

print("[farm v2] loaded - UI built, use START FARM or _G.BIOSYN_FARM.toggle(true)")
