-- AMMO-BOX CAMP
-- ================================================================
local camp = { map = nil, box = nil, pos = nil, besidePos = nil, underBad = false, nextScan = 0 }
local lastClaim = 0
local noGunWarnedAt = 0

local function boxPosition(box)
    if not box then return nil end
    if box:IsA("BasePart") then return box.Position end
    if box:IsA("Model") then
        if box.PrimaryPart then return box.PrimaryPart.Position end
        local p = box:FindFirstChildWhichIsA("BasePart")
        if p then return p.Position end
        local ok, pos = pcall(function() return box:GetPivot().Position end)
        if ok and pos then return pos end
    end
    return nil
end

-- active map = the map whose AmmoBoxes folder currently has boxes
local function activeAmmoFolder()
    local maps = workspace:FindFirstChild("Maps")
    if not maps then return nil, nil end
    local bestMap, bestFolder, bestCount = nil, nil, 0
    for _, map in ipairs(maps:GetChildren()) do
        local inter = map:FindFirstChild("Interactable")
        local ab = inter and inter:FindFirstChild("AmmoBoxes")
        if ab then
            local n = 0
            for _, c in ipairs(ab:GetChildren()) do
                if c:IsA("BasePart") or c:IsA("Model") then
                    n += 1
                end
            end
            if n > bestCount then
                bestMap, bestFolder, bestCount = map, ab, n
            end
        end
    end
    if bestCount == 0 then return nil, nil end
    return bestMap, bestFolder
end

-- lowest point of the box + ground search = a real "UNDER the box" spot
local underBox = {}
local function boxUnderPosition(box)
    if underBox[box] then return underBox[box] end
    local x, z, baseY
    pcall(function()
        local cf, size = box:GetBoundingBox()
        baseY = cf.Position.Y - size.Y / 2
        x = cf.Position.X
        z = cf.Position.Z
    end)
    if not baseY then
        local pos = boxPosition(box)
        if not pos then return nil end
        x, z, baseY = pos.X, pos.Z, pos.Y
    end
    local from = Vector3.new(x, baseY - 0.3, z)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local char = plr.Character
    params.FilterDescendantsInstances = char and { char, box } or { box }
    local hit = workspace:Raycast(from, Vector3.new(0, -25, 0), params)
    local spot
    if hit then
        spot = Vector3.new(x, hit.Position.Y + 3.2, z)
    else
        spot = Vector3.new(x, baseY - 3.2, z)
    end
    underBox[box] = spot
    return spot
end

local function pickBox(folder)
    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local best, bestD
    for _, c in ipairs(folder:GetChildren()) do
        local pos = boxPosition(c)
        if pos then
            local d = hrp and (pos - hrp.Position).Magnitude or math.huge
            if not best or d < bestD then
                best, bestD = c, d
            end
        end
    end
    if not best then
        best = folder:GetChildren()[1]
    end
    return best
end

local function campTick()
    -- menu open = not deployed: never camp, deploy first
    if menuOpen() then
        camp.nextScan = 0 -- fresh box scan right after deploying
        return
    end
    if plr.Team ~= teamPlayers then return end
    if not alive() then return end

    -- persistent camp: re-pivot whenever we drift away (respawn, push...)
    -- falling through a false floor -> permanently switch this box to the
    -- beside-the-box spot
    if camp.pos and camp.box and camp.box.Parent then
        local charC = plr.Character
        local hrp = charC and charC:FindFirstChild("HumanoidRootPart")
        if hrp then
            if hrp.AssemblyLinearVelocity.Y < -25 then
                camp.underBad = true
                if camp.besidePos then
                    camp.pos = camp.besidePos
                    underBox[camp.box] = "BESIDE"
                end
            end
            if camp.pos and (hrp.Position - camp.pos).Magnitude > 6 then
                pcall(function()
                    plr.Character:PivotTo(CFrame.new(camp.pos))
                end)
            end
        end
    end

    if tick() >= camp.nextScan or (camp.box and not camp.box.Parent) then
        camp.nextScan = tick() + 10
        local map, folder = activeAmmoFolder()
        if folder then
            if not camp.box or not camp.box.Parent or camp.map ~= map then
                camp.map = map
                camp.box = pickBox(folder)
                local underOrBase = camp.box and boxUnderPosition(camp.box)
                if underOrBase then
                    if underOrBase == "BESIDE" then
                        -- previous falling test proved this box's under-spot
                        -- has no floor - stay beside/on the platform (cached)
                        camp.underBad = true
                        if not camp.besidePos then
                            local base = boxPosition(camp.box)
                            camp.besidePos = base and (base + Vector3.new(0, 2.5, 0)) or nil
                        end
                        camp.pos = camp.besidePos
                    else
                        camp.underBad = false
                        camp.pos = underOrBase
                        local base = boxPosition(camp.box)
                        camp.besidePos = base and (base + Vector3.new(0, 2.5, 0)) or underOrBase
                    end
                    pcall(function()
                        plr.Character:PivotTo(CFrame.new(camp.pos))
                    end)
                    print("[farm v2] camping ammo box @ " .. map.Name .. " y=" .. string.format("%.1f", camp.pos.Y))
                end
            end
        else
            camp.map = nil
            camp.box = nil
        end
    end

    -- claim only when reserve runs low: the refill prompt needs close
    -- range, so when dry we step beside the box, claim, step back under
    if camp.box and tick() - lastClaim >= 4 then
        lastClaim = tick()
        local reserve = getAmmo()
        local dry = reserve <= cfg.resupplyAt
        if dry then
            local charC = plr.Character
            if camp.besidePos and (charC.HumanoidRootPart.Position - camp.besidePos).Magnitude > 3 then
                pcall(function() charC:PivotTo(CFrame.new(camp.besidePos)) end)
                task.wait(0.35)
            end
            local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            local bestP, bestD
            for _, d in ipairs(camp.box:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled and d.Parent then
                    local part = d.Parent:IsA("BasePart") and d.Parent or d.Parent.PrimaryPart
                    local dist = (hrp and part) and (part.Position - hrp.Position).Magnitude or 0
                    if not bestD or dist < bestD then
                        bestP, bestD = d, dist
                    end
                end
            end
            if bestP then
                local ok = false
                pcall(function()
                    if bestP.HoldDuration > 0.5 then
                        bestP.HoldDuration = 0.4
                    end
                    if fireproximityprompt then
                        fireproximityprompt(bestP) -- same as pressing E
                        ok = true
                    else
                        bestP:InputHoldBegin()
                        task.wait(0.55)
                        bestP:InputHoldEnd()
                        ok = true
                    end
                end)
                if ok then
                    stats.claims += 1
                    local after = getAmmo()
                    if after > reserve then
                        print("[farm v2] resupplied: " .. reserve .. " -> " .. after .. " rounds")
                    end
                end
            end
            if camp.besidePos and camp.pos and camp.pos ~= camp.besidePos then
                task.wait(0.25)
                pcall(function() plr.Character:PivotTo(CFrame.new(camp.pos)) end)
            end
        end
    end
end

