-- ================================================================
-- MOBILE SHOW/HIDE BUTTON — floating button that toggles the hub
-- window; works on touch AND mouse (tap or click).
-- ================================================================
task.spawn(function()
    local UserInputService = game:GetService("UserInputService")

    -- remove toggle buttons from previous runs (no duplicates)
    pcall(function()
        local containers = {}
        local okHui, hui = pcall(function() return gethui and gethui() end)
        if okHui and hui then table.insert(containers, hui) end
        pcall(function() table.insert(containers, game:GetService("CoreGui")) end)
        table.insert(containers, plr:FindFirstChild("PlayerGui"))
        for _, container in ipairs(containers) do
            if container then
                for _, gui in ipairs(container:GetChildren()) do
                    if gui:IsA("ScreenGui") and gui.Name == "BIOSYN_MobileToggle" then
                        gui:Destroy()
                    end
                end
            end
        end
    end)

    -- Mercury wraps its window in a tweened "core" frame controlled by
    -- window:show(state) — that's the same path its own K keybind uses.
    local hubVisible = true      -- window starts visible

    local function toggleHub()
        hubVisible = not hubVisible
        pcall(function()
            window:show(hubVisible)
        end)
    end
    _G.BIOSYN_TOGGLE = function(force)
        if force == nil then force = not hubVisible end
        hubVisible = force
        pcall(function()
            window:show(hubVisible)
        end)
        return hubVisible
    end

    -- floating button (parented to a CoreGui holder so the game cannot delete it)
    local holderOk, holder = pcall(function()
        local okHui, hui = pcall(function() return gethui and gethui() end)
        return (okHui and hui) or game:GetService("CoreGui")
    end)
    if not holderOk or not holder then holder = plr:FindFirstChild("PlayerGui") end

    local screen = Instance.new("ScreenGui")
    screen.Name = "BIOSYN_MobileToggle"
    screen.ResetOnSpawn = false
    screen.IgnoreGuiInset = true
    screen.DisplayOrder = 999999

    local btn = Instance.new("TextButton")
    btn.Name = "ToggleHub"
    btn.Text = "⬡"
    btn.TextSize = 26
    btn.Font = Enum.Font.GothamBold
    btn.TextColor3 = Color3.fromRGB(235, 235, 255)
    btn.BackgroundColor3 = Color3.fromRGB(35, 30, 55)
    btn.BackgroundTransparency = 0.15
    btn.Size = UDim2.fromOffset(56, 56)
    btn.Position = UDim2.new(1, -66, 0, 66)      -- top-right, thumb friendly
    btn.Active = true
    btn.Visible = true                           -- always visible (mouse + touch)
    screen.Parent = holder
    btn.Parent = screen

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(150, 120, 255)
    stroke.Thickness = 2
    stroke.Parent = btn

    -- tap/click = toggle; drag = move 1:1 with the cursor.
    -- FIX: the old math mixed two coordinate spaces (input position vs the
    -- gui's own offset space — the hidden UI container shifts our gui
    -- vertically), so the button TELEPORTED toward the wrong corner the
    -- moment a drag started. Every move is now anchored to the button's
    -- live AbsolutePosition + this event's Delta, then clamped to the
    -- viewport: it follows the cursor exactly and can never leave screen.
    local dragging = false
    local dragMoved = false
    local pressInput
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragMoved = false
            pressInput = Vector2.new(input.Position.X, input.Position.Y)
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging and not dragMoved then
                _G.BIOSYN_TOGGLE()
            end
            dragging = false
            pressInput = nil
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not (dragging and pressInput and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)) then
            return
        end
        -- dead zone: anything within 8px of the press counts as a click
        if not dragMoved then
            if (Vector2.new(input.Position.X, input.Position.Y) - pressInput).Magnitude > 8 then
                dragMoved = true
            else
                return
            end
        end
        if dragMoved then
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
            if vp.X > 200 and vp.Y > 200 then
                local abs = btn.AbsolutePosition
                local size = btn.AbsoluteSize
                local nx = math.clamp(abs.X + input.Delta.X, 8, vp.X - size.X - 8)
                local ny = math.clamp(abs.Y + input.Delta.Y, 8, vp.Y - size.Y - 8)
                btn.Position = UDim2.fromOffset(nx - screen.AbsolutePosition.X, ny - screen.AbsolutePosition.Y)
            end
        end
    end)

    -- Mercury's own K keybind keeps working; keep our flag in sync
    pcall(function()
        UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == Enum.KeyCode.K then
                hubVisible = not hubVisible
            end
        end)
    end)

    print("[✓] ⬡ toggle: ready (tap/click to show/hide hub)")
end)

