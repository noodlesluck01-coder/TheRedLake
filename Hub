-- ================================================================
-- ATTACK - hub kill aura, exact port (gun packets only, melee never)
-- ================================================================
local function validTarget(target)
    if not target or not target.Parent then return false end
    local hum = target:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then
        cacheTimestamp = 0
        return false
    end
    return (target:FindFirstChild("Head") ~= nil)
        or (target:FindFirstChild("HumanoidRootPart") ~= nil)
end

local function attackTick()
    if not alive() then return end
    if menuOpen() then return end -- menu open = not deployed: never fire
    local tool, remote = getGun()
    if not remote then
        if cfg.autoWeapons and autoEquipGun() then
            return -- next tick fires with the equipped gun
        end
        if tick() - noGunWarnedAt > 20 then
            noGunWarnedAt = tick()
            print("[farm v2] no gun available yet - waiting for loadout")
        end
        return
    end
    local target = getclosestenemy()
    if not validTarget(target) then return end

    local head = target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
    local ammo = getAmmo()

    stats.shots += 1
    lastShotTarget = target
    lastShotTime = tick()
    pcall(function()
        -- identical to the hub kill aura: DAMAGE always fires (this kills);
        -- AMMO/MUZZLE are cosmetic shot-feel, gated on reserve
        remote:FireServer("DAMAGE", { head, head.Position, 0, false })
        if ammo and ammo >= 10 then
            remote:FireServer("AMMO")
            local handle = tool:FindFirstChild("Handle")
            local barrel = handle and handle:FindFirstChild("Barrel")
            if barrel then
                remote:FireServer("MUZZLE", barrel)
            end
        end
    end)
end

