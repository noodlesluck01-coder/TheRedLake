-- ================================================================
-- ESP (single update loop, safe cleanup)
-- ================================================================
local espEnabled = false
local espLoopRunning = false
local espHighlights = {}

local function updateESP()
    if not espEnabled then
        for i = #espHighlights, 1, -1 do
            local h = espHighlights[i]
            pcall(function() h:Destroy() end)
            table.remove(espHighlights, i)
        end
        return
    end

    local enemies = refreshEnemyCache()

    for i = #espHighlights, 1, -1 do
        local h = espHighlights[i]
        local dead = false
        pcall(function()
            dead = (not h.Parent) or (not h.Adornee) or (not h.Adornee.Parent)
        end)
        if dead then
            pcall(function() h:Destroy() end)
            table.remove(espHighlights, i)
        end
    end

    for _, enemy in ipairs(enemies) do
        local hasHighlight = false
        for _, h in ipairs(espHighlights) do
            if h.Adornee == enemy then
                hasHighlight = true
                break
            end
        end
        if not hasHighlight then
            local highlight = Instance.new("Highlight")
            highlight.FillTransparency = 1
            highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
            highlight.OutlineTransparency = 0
            highlight.Adornee = enemy
            highlight.Parent = enemy
            table.insert(espHighlights, highlight)
        end
    end
end

local function setESP(state)
    espEnabled = state
    if state then
        if not espLoopRunning then
            espLoopRunning = true
            task.spawn(function()
                while espEnabled do
                    pcall(updateESP)
                    sleepWhile(function() return espEnabled end, 0.75)
                end
                espLoopRunning = false
                pcall(updateESP)
            end)
        end
    else
        pcall(updateESP) -- clears highlights immediately
    end
end
_G.BIOSYN_SETESP = setESP

