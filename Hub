-- MAIN LOOPS
-- ================================================================
local wasAlive = true
local deathDumped = 0

local function dumpDeathOptions()
    if tick() - deathDumped < 30 then return end
    deathDumped = tick()
    local pg = plr:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, name in ipairs({ "DeathScreen", "Death", "downMechanic", "RespawnChoice" }) do
        local gui = pg:FindFirstChild(name)
        if gui and gui.Enabled then
            for _, d in ipairs(gui:GetDescendants()) do
                if d:IsA("TextButton") and d.Visible and d.Text ~= "" then
                    print("[farm v2] death-btn> " .. d:GetFullName() .. " => '" .. tostring(d.Text) .. "'")
                end
            end
        end
    end
end

local loopsAlive = {}
local function looper(name, fn, rate)
    loopsAlive[name] = true
    task.spawn(function()
        while loopsAlive[name] and genv.BIOSYN_FARM_RUN_ID == RUN_ID do
            if farmOn then
                local ok, err = pcall(fn)
                if not ok then
                    print("[farm v2] " .. name .. " error: " .. tostring(err))
                end
            end
            task.wait(rate)
        end
        loopsAlive[name] = nil
    end)
end

looper("attack", attackTick, cfg.attackRate)
looper("camp", campTick, 1)
looper("state", function()
    voteTick()
    if cfg.autoCards then
        pickTick()
    end
    streakTick()
    local nowAlive = alive()
    if nowAlive and not wasAlive then
        stats.deaths += 1
        print("[farm v2] died -> waiting respawn (deaths #" .. stats.deaths .. ")")
        dumpDeathOptions()
    end
    wasAlive = nowAlive
    if not nowAlive then
        respawnClick()
    end
    tryDeploy()
end, 0.7)

