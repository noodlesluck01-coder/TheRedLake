-- anti-stutter: throttle ambient/emitter storm (fog, poison goo, portals,
-- weapon barrel flames, fireflies). Purely visual — no gameplay effect.
task.spawn(function()
    local function matchesAmbient(n)
        local l = string.lower(n or "")
        for _, pat in ipairs({ "icy fog", "forest", "poongoo", "goo", "poison", "portal", "spark", "firefly", "fog" }) do
            if l:find(pat, 1, true) then return true end
        end
        return false
    end
    local function throttle(root)
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("ParticleEmitter") then
                local a = d.Parent
                local b = a and a.Parent
                local bg = (b and b.Name) or ""
                local pn = (a and a.Name) or ""
                -- environmental haze: disable outright
                if (string.lower(bg):find("icy fog") or string.lower(bg):find("forest") or string.lower(bg):find("fog")) and d.Enabled then
                    pcall(function() d.Enabled = false end)
                elseif (matchesAmbient(bg .. pn) or pn == "Particles" or bg == "ToAnimte") and d.Rate > 8 then
                    pcall(function() d.Rate = 8 end)
                elseif a and a.Name == "Barrel" and d.Rate > 8 then
                    pcall(function() d.Rate = 8 end)           -- burning weapon flames
                end
            end
        end
    end
    throttle(workspace)
    -- keep watching for newly spawned ambient emitters while playing
    local conn
    conn = workspace.DescendantAdded:Connect(function(d)
        if d:IsA("ParticleEmitter") then
            task.delay(0.1, function()
                if not d.Parent then return end
                local a = d.Parent
                local b = a and a.Parent
                local n = string.lower(((b and b.Name) or "") .. " " .. ((a and a.Name) or ""))
                if n:find("icy fog") or n:find("forest") or n:find("fog") then
                    pcall(function() d.Enabled = false end)
                elseif matchesAmbient(n) or (a and (a.Name == "Particles" or a.Name == "Barrel") or (b and b.Name == "ToAnimte")) then
                    pcall(function() if d.Rate > 8 then d.Rate = 8 end end)
                end
            end)
        end
    end)
    -- drop watchers from previous runs instead of stacking them
    if _G.BIOSYN_CLEANUP then
        for _, c in ipairs(_G.BIOSYN_CLEANUP) do
            pcall(function() c:Disconnect() end)
        end
        _G.BIOSYN_CLEANUP = {}
    else
        _G.BIOSYN_CLEANUP = {}
    end
    table.insert(_G.BIOSYN_CLEANUP, conn)
end)

